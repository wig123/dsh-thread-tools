{
  "name": "@wig123/dsh-thread-tools",
  "version": "0.1.0",
  "description": "Cross-session tools for DeepSeek Harness: list the deployment’s other sessions and deliver a message to a live one",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "session",
    "thread"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wig123/dsh-thread-tools.git"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf lib"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0 <5",
    "@deepseek-ai/dsh-agent": ">=0.1.0 <0.2",
    "@deepseek-ai/dsh-brand": ">=0.1.0 <0.2",
    "@deepseek-ai/dsh-llm": ">=0.1.0 <0.2",
    "@deepseek-ai/dsh-session": ">=0.1.0 <0.2",
    "@deepseek-ai/dsh-session-persistence": ">=0.1.0 <0.2",
    "@deepseek-ai/dsh-session-query": ">=0.1.0 <0.2",
    "@deepseek-ai/dsh-session-title": ">=0.1.0 <0.2",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.0 <0.2",
    "@deepseek-ai/dsh-tools": ">=0.1.0 <0.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-session-query": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-title": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-brand": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-llm": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-session": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-session-persistence": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-session-query": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-session-title": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-tools": "0.1.5-alpha.2",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
